FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object fvSolution;
}

solvers
{
    "(rho|rhoU|rhoE)"
    {
        solver diagonal; // Handles diagonal systems
    }

    "U"
    {
        solver smoothSolver; // Iterative smoother-based solver
        smoother GaussSeidel; // Specifies the smoother
        tolerance 1e-9; // Residual Target
        relTol 0; // Disables relative early termination
    }

    "e"
    {
        solver smoothSolver;
        smoother GaussSeidel;
        tolerance 1e-9;
        relTol 0;
    }
}